<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.upx.doando_mais.ui.auth.LoginFragment"
        android:label="LoginFragment"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_loginFragment_to_feedFragment"
            app:destination="@id/feedFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_loginFragment_to_cadastroFragment"
            app:destination="@id/cadastroFragment" />

        <action
            android:id="@+id/action_loginFragment_to_esqueceuSenhaFragment"
            app:destination="@id/esqueceuSenhaFragment" />

    </fragment>

    <fragment
        android:id="@+id/cadastroFragment"
        android:name="com.upx.doando_mais.ui.auth.CadastroFragment"
        android:label="CadastroFragment"
        tools:layout="@layout/fragment_cadastro">
        <action
            android:id="@+id/action_cadastroFragment_to_feedFragment"
            app:destination="@id/feedFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/esqueceuSenhaFragment"
        android:name="com.upx.doando_mais.ui.auth.EsqueceuSenhaFragment"
        android:label="EsqueceuSenhaFragment"
        tools:layout="@layout/fragment_esqueceu_senha" />

    <fragment
        android:id="@+id/feedFragment"
        android:name="com.upx.doando_mais.ui.feed.FeedFragment"
        android:label="FeedFragment"
        tools:layout="@layout/fragment_feed">
        <action
            android:id="@+id/action_feedFragment_to_detalheCampanhaFragment"
            app:destination="@id/detalheCampanhaFragment" />
    </fragment>

    <fragment
        android:id="@+id/acompanhamentoFragment"
        android:name="com.upx.doando_mais.ui.acompanhamento.AcompanhamentoFragment"
        android:label="AcompanhamentoFragment"
        tools:layout="@layout/fragment_acompanhamento" >
        <action
            android:id="@+id/action_acompanhamentoFragment_to_editarCampanhaFragment"
            app:destination="@id/editarCampanhaFragment" />
    </fragment>

    <fragment
        android:id="@+id/criarCampanhaFragment"
        android:name="com.upx.doando_mais.ui.campanha_criar.CriarCampanhaFragment"
        android:label="CriarCampanhaFragment"
        tools:layout="@layout/fragment_criar_campanha" >
        <action
            android:id="@+id/action_criarCampanhaFragment_to_formPacienteFragment"
            app:destination="@id/formPacienteFragment" />
        <action
            android:id="@+id/action_criarCampanhaFragment_to_formAbertaFragment"
            app:destination="@id/formAbertaFragment" />
    </fragment>

    <fragment
        android:id="@+id/orientacoesFragment"
        android:name="com.upx.doando_mais.ui.orientacoes.OrientacoesFragment"
        android:label="OrientacoesFragment"
        tools:layout="@layout/fragment_orientacoes" />

    <fragment
        android:id="@+id/perfilFragment"
        android:name="com.upx.doando_mais.ui.perfil.PerfilFragment"
        android:label="PerfilFragment"
        tools:layout="@layout/fragment_perfil">
        <action
            android:id="@+id/action_perfilFragment_to_atualizarCadastroFragment"
            app:destination="@id/atualizarCadastroFragment" />
        <action
            android:id="@+id/action_perfilFragment_to_alterarSenhaFragment"
            app:destination="@id/alterarSenhaFragment" />
        <action
            android:id="@+id/action_perfilFragment_to_sobreAppFragment"
            app:destination="@id/sobreAppFragment" />
        <action
            android:id="@+id/action_perfilFragment_to_excluirContaFragment"
            app:destination="@id/excluirContaFragment" />
    </fragment>

    <fragment
        android:id="@+id/atualizarCadastroFragment"
        android:name="com.upx.doando_mais.ui.perfil.AtualizarCadastroFragment"
        android:label="AtualizarCadastroFragment"
        tools:layout="@layout/fragment_atualizar_cadastro" />

    <fragment
        android:id="@+id/detalheCampanhaFragment"
        android:name="com.upx.doando_mais.ui.campanha_detalhe.DetalheCampanhaFragment"
        android:label="DetalheCampanhaFragment"
        tools:layout="@layout/fragment_detalhe_campanha">
        <argument
            android:name="campanhaId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/editarCampanhaFragment"
        android:name="com.upx.doando_mais.ui.campanha_editar.EditarCampanhaFragment"
        android:label="EditarCampanhaFragment"
        tools:layout="@layout/fragment_editar_campanha">
        <argument
            android:name="campanhaId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/alterarSenhaFragment"
        android:name="com.upx.doando_mais.ui.perfil.AlterarSenhaFragment"
        android:label="AlterarSenhaFragment"
        tools:layout="@layout/fragment_alterar_senha" />

    <fragment
        android:id="@+id/sobreAppFragment"
        android:name="com.upx.doando_mais.ui.perfil.SobreAppFragment"
        android:label="SobreAppFragment"
        tools:layout="@layout/fragment_sobre_app" />

    <fragment
        android:id="@+id/excluirContaFragment"
        android:name="com.upx.doando_mais.ui.perfil.ExcluirContaFragment"
        android:label="ExcluirContaFragment"
        tools:layout="@layout/fragment_excluir_conta" />

    <fragment
        android:id="@+id/formPacienteFragment"
        android:name="com.upx.doando_mais.ui.campanha_criar.FormPacienteFragment"
        android:label="Formulário Paciente"
        tools:layout="@layout/fragment_form_paciente" />

    <fragment
        android:id="@+id/formAbertaFragment"
        android:name="com.upx.doando_mais.ui.campanha_criar.FormAbertaFragment"
        android:label="Formulário Campanha Pública"
        tools:layout="@layout/fragment_form_publica" />

    <fragment
        android:id="@+id/registrarDoacaoFragment"
        android:name="com.upx.doando_mais.ui.doacao_registrar.RegistrarDoacaoFragment"
        android:label="Registrar Doação"
        tools:layout="@layout/fragment_registrar_doacao" />
    <fragment
        android:id="@+id/minhasDoacoesFragment"
        android:name="com.upx.doando_mais.ui.perfil.MinhasDoacoesFragment"
        android:label="Minhas Doações"
        tools:layout="@layout/fragment_minhas_doacoes" />

</navigation>